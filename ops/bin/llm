#!/usr/bin/env bash
# 로컬 LLM(LM Studio) 한 방 질의 도구.
# 사용법:
#   llm "질문"                     # 인자로 질문
#   echo "코드" | llm "요약해줘"    # stdin을 컨텍스트로
#   llm -f "어려운 질문"           # 30B 모델 사용 (기본은 빠른 7B)
#   git diff | llm "이 변경 요약"
#
# 환경변수:
#   LLM_HOST           기본 http://localhost:1234
#   LLM_FAST           빠른 모델 키 (기본 qwen/qwen2.5-coder-7b)
#   LLM_BIG            주력 모델 키 (기본 qwen/qwen3-coder-30b)
#   LLM_TTL            유휴 이 초 후 모델 자동 언로드 (기본 600)
#   LLM_CURL_TIMEOUT   응답 대기 상한 초 (기본 300; 훅에서는 짧게)
set -euo pipefail

HOST="${LLM_HOST:-http://localhost:1234}"
FAST="${LLM_FAST:-qwen/qwen2.5-coder-7b}"
BIG="${LLM_BIG:-qwen/qwen3-coder-30b}"
TTL="${LLM_TTL:-600}"
CURL_TIMEOUT="${LLM_CURL_TIMEOUT:-300}"
MODEL="$FAST"
SYSTEM="You are a concise coding assistant. Answer in Korean unless asked otherwise. Be brief and give only what's asked."

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -f|--full|--big) MODEL="$BIG"; shift ;;
    -s|--system) SYSTEM="$2"; shift 2 ;;
    -m|--model)  MODEL="$2"; shift 2 ;;
    -h|--help)   grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "알 수 없는 옵션: $1" >&2; exit 1 ;;
  esac
done

PROMPT="${*:-}"
STDIN=""
if [ ! -t 0 ]; then STDIN="$(cat)"; fi

if [ -z "$PROMPT" ] && [ -z "$STDIN" ]; then
  echo "질문을 입력하세요. 예: llm \"파이썬으로 파일 읽는 법\"" >&2
  exit 1
fi

USER_CONTENT="$PROMPT"
[ -n "$STDIN" ] && USER_CONTENT=$'다음 내용을 참고해서 답해줘:\n\n'"$STDIN"$'\n\n요청: '"$PROMPT"

BODY=$(jq -n --arg m "$MODEL" --arg s "$SYSTEM" --arg u "$USER_CONTENT" --argjson ttl "$TTL" '{
  model: $m, temperature: 0.3, stream: false, ttl: $ttl,
  messages: [ {role:"system", content:$s}, {role:"user", content:$u} ]
}')

RESP=$(curl -sS -m "$CURL_TIMEOUT" "$HOST/v1/chat/completions" \
  -H 'Content-Type: application/json' -d "$BODY") || {
  echo "로컬 LLM 서버에 연결 실패. 'lms server start' 로 서버를 켜세요." >&2
  exit 1
}

echo "$RESP" | jq -r '.choices[0].message.content // (.error.message // "응답 파싱 실패") ' 2>/dev/null || echo "$RESP"
